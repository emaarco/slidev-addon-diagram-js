      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_subscriptionRequestedToBeforeSendConfirmationMail_di" bpmnElement="flow_subscriptionRequestedToBeforeSendConfirmationMail">
        <di:waypoint x="248" y="203" />
