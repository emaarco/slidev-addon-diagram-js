<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:sim="http://example.org/simulation" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="definitions_bikeOrder" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="bikeOrder" name="Bike order" isExecutable="true">
    <bpmn:startEvent id="startEvent_orderReceived" name="Order received">
      <bpmn:outgoing>flow_orderReceivedToCheckCreditRating</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_checkCreditRating" name="Check credit rating" sim:duration="1">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="checkCreditRating" />
        <zeebe:ioMapping>
          <zeebe:input source="=customer.id" target="customerId" />
          <zeebe:output source="=score" target="creditScore" />
          <zeebe:output source="=score &#62;= 600" target="creditworthy" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_orderReceivedToCheckCreditRating</bpmn:incoming>
      <bpmn:outgoing>flow_checkCreditRatingToCreditOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_creditOk" name="Credit OK?" default="flow_creditOkToOrderRejected">
      <bpmn:incoming>flow_checkCreditRatingToCreditOk</bpmn:incoming>
      <bpmn:outgoing>flow_creditOkToBeforeShipOrder</bpmn:outgoing>
      <bpmn:outgoing>flow_creditOkToReviewOrder</bpmn:outgoing>
      <bpmn:outgoing>flow_creditOkToOrderRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_beforeShipOrder">
      <bpmn:incoming>flow_creditOkToBeforeShipOrder</bpmn:incoming>
      <bpmn:incoming>flow_approvedToBeforeShipOrder</bpmn:incoming>
      <bpmn:outgoing>flow_beforeShipOrderToShipOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="serviceTask_shipOrder" name="Ship order" sim:duration="2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shipOrder" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_beforeShipOrderToShipOrder</bpmn:incoming>
      <bpmn:outgoing>flow_shipOrderToExtras</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="gateway_extras" name="Extras?" default="flow_extrasToExtrasDone">
      <bpmn:incoming>flow_shipOrderToExtras</bpmn:incoming>
      <bpmn:outgoing>flow_extrasToAddInsurance</bpmn:outgoing>
      <bpmn:outgoing>flow_extrasToPackAccessories</bpmn:outgoing>
      <bpmn:outgoing>flow_extrasToExtrasDone</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="serviceTask_addInsurance" name="Add insurance" sim:duration="1">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="addInsurance" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_extrasToAddInsurance</bpmn:incoming>
      <bpmn:outgoing>flow_addInsuranceToExtrasDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="gateway_extrasDone">
      <bpmn:incoming>flow_addInsuranceToExtrasDone</bpmn:incoming>
      <bpmn:incoming>flow_packAccessoriesToExtrasDone</bpmn:incoming>
      <bpmn:incoming>flow_extrasToExtrasDone</bpmn:incoming>
      <bpmn:outgoing>flow_extrasDoneToOrderShipped</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="endEvent_orderShipped" name="Order shipped">
      <bpmn:incoming>flow_extrasDoneToOrderShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_extrasDoneToOrderShipped" sourceRef="gateway_extrasDone" targetRef="endEvent_orderShipped" />
    <bpmn:sequenceFlow id="flow_addInsuranceToExtrasDone" sourceRef="serviceTask_addInsurance" targetRef="gateway_extrasDone" />
    <bpmn:sequenceFlow id="flow_extrasToAddInsurance" name="insurance" sourceRef="gateway_extras" targetRef="serviceTask_addInsurance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=insurance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="serviceTask_packAccessories" name="Pack accessories" sim:duration="1">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="packAccessories" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_extrasToPackAccessories</bpmn:incoming>
      <bpmn:outgoing>flow_packAccessoriesToExtrasDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_packAccessoriesToExtrasDone" sourceRef="serviceTask_packAccessories" targetRef="gateway_extrasDone" />
    <bpmn:sequenceFlow id="flow_extrasToPackAccessories" name="accessories" sourceRef="gateway_extras" targetRef="serviceTask_packAccessories">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(accessories) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_extrasToExtrasDone" name="none" sourceRef="gateway_extras" targetRef="gateway_extrasDone" />
    <bpmn:sequenceFlow id="flow_shipOrderToExtras" sourceRef="serviceTask_shipOrder" targetRef="gateway_extras" />
    <bpmn:sequenceFlow id="flow_beforeShipOrderToShipOrder" sourceRef="gateway_beforeShipOrder" targetRef="serviceTask_shipOrder" />
    <bpmn:sequenceFlow id="flow_creditOkToBeforeShipOrder" name="yes" sourceRef="gateway_creditOk" targetRef="gateway_beforeShipOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditworthy and orderTotal &lt;= 5000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="userTask_reviewOrder" name="Review order" sim:duration="3">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="reviewOrder" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_creditOkToReviewOrder</bpmn:incoming>
      <bpmn:outgoing>flow_reviewOrderToApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_approved" name="Approved?">
      <bpmn:incoming>flow_reviewOrderToApproved</bpmn:incoming>
      <bpmn:outgoing>flow_approvedToBeforeShipOrder</bpmn:outgoing>
      <bpmn:outgoing>flow_approvedToOrderRejectedInReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_approvedToBeforeShipOrder" name="yes" sourceRef="gateway_approved" targetRef="gateway_beforeShipOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="endEvent_orderRejectedInReview" name="Order rejected in review">
      <bpmn:incoming>flow_approvedToOrderRejectedInReview</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_approvedToOrderRejectedInReview" name="no" sourceRef="gateway_approved" targetRef="endEvent_orderRejectedInReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(approved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reviewOrderToApproved" sourceRef="userTask_reviewOrder" targetRef="gateway_approved" />
    <bpmn:sequenceFlow id="flow_creditOkToReviewOrder" name="large order" sourceRef="gateway_creditOk" targetRef="userTask_reviewOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditworthy and orderTotal &gt; 5000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="endEvent_orderRejected" name="Order rejected">
      <bpmn:incoming>flow_creditOkToOrderRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_creditOkToOrderRejected" name="no" sourceRef="gateway_creditOk" targetRef="endEvent_orderRejected" />
    <bpmn:sequenceFlow id="flow_checkCreditRatingToCreditOk" sourceRef="serviceTask_checkCreditRating" targetRef="gateway_creditOk" />
    <bpmn:sequenceFlow id="flow_orderReceivedToCheckCreditRating" sourceRef="startEvent_orderReceived" targetRef="serviceTask_checkCreditRating" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bikeOrder">
    <bpmndi:BPMNPlane id="BPMNPlane_bikeOrder" bpmnElement="bikeOrder">
      <bpmndi:BPMNShape id="BPMNShape_startEvent_orderReceived" bpmnElement="startEvent_orderReceived">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="64" y="144" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_serviceTask_checkCreditRating" bpmnElement="serviceTask_checkCreditRating">
        <dc:Bounds x="176" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_creditOk" bpmnElement="gateway_creditOk" isMarkerVisible="true">
        <dc:Bounds x="336" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="367" y="75" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_beforeShipOrder" bpmnElement="gateway_beforeShipOrder" isMarkerVisible="true">
        <dc:Bounds x="606" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_serviceTask_shipOrder" bpmnElement="serviceTask_shipOrder">
        <dc:Bounds x="716" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_extras" bpmnElement="gateway_extras">
        <dc:Bounds x="876" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="907" y="75" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_serviceTask_addInsurance" bpmnElement="serviceTask_addInsurance">
        <dc:Bounds x="1031" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_extrasDone" bpmnElement="gateway_extrasDone">
        <dc:Bounds x="1191" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endEvent_orderShipped" bpmnElement="endEvent_orderShipped">
        <dc:Bounds x="1301" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1289" y="144" width="61" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_serviceTask_packAccessories" bpmnElement="serviceTask_packAccessories">
        <dc:Bounds x="1031" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_userTask_reviewOrder" bpmnElement="userTask_reviewOrder">
        <dc:Bounds x="446" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_approved" bpmnElement="gateway_approved" isMarkerVisible="true">
        <dc:Bounds x="606" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="229" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endEvent_orderRejectedInReview" bpmnElement="endEvent_orderRejectedInReview">
        <dc:Bounds x="723" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="697" y="294" width="89" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endEvent_orderRejected" bpmnElement="endEvent_orderRejected">
        <dc:Bounds x="446" y="-48" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="-6" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_extrasDoneToOrderShipped" bpmnElement="flow_extrasDoneToOrderShipped">
        <di:waypoint x="1241" y="120" />
        <di:waypoint x="1301" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_addInsuranceToExtrasDone" bpmnElement="flow_addInsuranceToExtrasDone">
        <di:waypoint x="1131" y="120" />
        <di:waypoint x="1191" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_extrasToAddInsurance" bpmnElement="flow_extrasToAddInsurance">
        <di:waypoint x="926" y="120" />
        <di:waypoint x="1031" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="934" y="102" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_packAccessoriesToExtrasDone" bpmnElement="flow_packAccessoriesToExtrasDone">
        <di:waypoint x="1131" y="270" />
        <di:waypoint x="1216" y="270" />
        <di:waypoint x="1216" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_extrasToPackAccessories" bpmnElement="flow_extrasToPackAccessories">
        <di:waypoint x="901" y="145" />
        <di:waypoint x="901" y="270" />
        <di:waypoint x="1031" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="909" y="252" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_extrasToExtrasDone" bpmnElement="flow_extrasToExtrasDone">
        <di:waypoint x="901" y="95" />
        <di:waypoint x="901" y="-30" />
        <di:waypoint x="1216" y="-30" />
        <di:waypoint x="1216" y="95" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="909" y="-48" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_shipOrderToExtras" bpmnElement="flow_shipOrderToExtras">
        <di:waypoint x="816" y="120" />
        <di:waypoint x="876" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_beforeShipOrderToShipOrder" bpmnElement="flow_beforeShipOrderToShipOrder">
        <di:waypoint x="656" y="120" />
        <di:waypoint x="716" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_creditOkToBeforeShipOrder" bpmnElement="flow_creditOkToBeforeShipOrder">
        <di:waypoint x="386" y="120" />
        <di:waypoint x="606" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="102" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_approvedToBeforeShipOrder" bpmnElement="flow_approvedToBeforeShipOrder">
        <di:waypoint x="631" y="245" />
        <di:waypoint x="631" y="145" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="637" y="193" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_approvedToOrderRejectedInReview" bpmnElement="flow_approvedToOrderRejectedInReview">
        <di:waypoint x="656" y="270" />
        <di:waypoint x="723" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="252" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_reviewOrderToApproved" bpmnElement="flow_reviewOrderToApproved">
        <di:waypoint x="546" y="270" />
        <di:waypoint x="606" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_creditOkToReviewOrder" bpmnElement="flow_creditOkToReviewOrder">
        <di:waypoint x="361" y="145" />
        <di:waypoint x="361" y="270" />
        <di:waypoint x="446" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="349" y="274" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_creditOkToOrderRejected" bpmnElement="flow_creditOkToOrderRejected">
        <di:waypoint x="361" y="95" />
        <di:waypoint x="361" y="-30" />
        <di:waypoint x="446" y="-30" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="369" y="-48" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_checkCreditRatingToCreditOk" bpmnElement="flow_checkCreditRatingToCreditOk">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_orderReceivedToCheckCreditRating" bpmnElement="flow_orderReceivedToCheckCreditRating">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="176" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
