<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_LoanApproval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:process id="loanApproval" name="Loan Approval" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="startEvent_loanRequested" name="Loan&#10;requested" camunda:asyncBefore="true">
      <bpmn:outgoing>flow_loanRequestedToScoreApplicant</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_scoreApplicant" name="Score applicant" camunda:expression="${scoringService.score(applicantId)}" camunda:resultVariable="score" camunda:asyncBefore="true">
      <bpmn:incoming>flow_loanRequestedToScoreApplicant</bpmn:incoming>
      <bpmn:outgoing>flow_scoreApplicantToScoreOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_scoreOk" name="Score ok?">
      <bpmn:incoming>flow_scoreApplicantToScoreOk</bpmn:incoming>
      <bpmn:outgoing>flow_scoreOkToApproveLoan</bpmn:outgoing>
      <bpmn:outgoing>flow_scoreOkToLoanRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_approveLoan" name="Approve loan" camunda:assignee="clerk" camunda:asyncAfter="true">
      <bpmn:incoming>flow_scoreOkToApproveLoan</bpmn:incoming>
      <bpmn:outgoing>flow_approveLoanToLoanApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="endEvent_loanApproved" name="Loan&#10;approved">
      <bpmn:incoming>flow_approveLoanToLoanApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endEvent_loanRejected" name="Loan&#10;rejected">
      <bpmn:incoming>flow_scoreOkToLoanRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_loanRequestedToScoreApplicant" sourceRef="startEvent_loanRequested" targetRef="serviceTask_scoreApplicant" />
    <bpmn:sequenceFlow id="flow_scoreApplicantToScoreOk" sourceRef="serviceTask_scoreApplicant" targetRef="gateway_scoreOk" />
    <bpmn:sequenceFlow id="flow_scoreOkToApproveLoan" name="yes" sourceRef="gateway_scoreOk" targetRef="userTask_approveLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${score &gt;= 700}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_scoreOkToLoanRejected" name="no" sourceRef="gateway_scoreOk" targetRef="endEvent_loanRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${score &lt; 700}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approveLoanToLoanApproved" sourceRef="userTask_approveLoan" targetRef="endEvent_loanApproved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loanApproval">
      <bpmndi:BPMNShape id="startEvent_loanRequested_di" bpmnElement="startEvent_loanRequested">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="61" y="144" width="75" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_scoreApplicant_di" bpmnElement="serviceTask_scoreApplicant">
        <dc:Bounds x="176" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_scoreOk_di" bpmnElement="gateway_scoreOk" isMarkerVisible="true">
        <dc:Bounds x="336" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="324" y="75" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_approveLoan_di" bpmnElement="userTask_approveLoan">
        <dc:Bounds x="446" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_loanApproved_di" bpmnElement="endEvent_loanApproved">
        <dc:Bounds x="606" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="590" y="144" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_loanRejected_di" bpmnElement="endEvent_loanRejected">
        <dc:Bounds x="478" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="462" y="262" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_loanRequestedToScoreApplicant_di" bpmnElement="flow_loanRequestedToScoreApplicant">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="176" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_scoreApplicantToScoreOk_di" bpmnElement="flow_scoreApplicantToScoreOk">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_scoreOkToApproveLoan_di" bpmnElement="flow_scoreOkToApproveLoan">
        <di:waypoint x="386" y="120" />
        <di:waypoint x="446" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="102" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_scoreOkToLoanRejected_di" bpmnElement="flow_scoreOkToLoanRejected">
        <di:waypoint x="361" y="145" />
        <di:waypoint x="361" y="238" />
        <di:waypoint x="478" y="238" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="369" y="220" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approveLoanToLoanApproved_di" bpmnElement="flow_approveLoanToLoanApproved">
        <di:waypoint x="546" y="120" />
        <di:waypoint x="606" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
