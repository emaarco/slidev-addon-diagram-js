{
  "name": "slidev-addon-diagram-js",
  "version": "2.0.0",
  "description": "Display BPMN, DMN and other diagram-js based models in Slidev presentations",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "slidev example.md --port $PORT --remote --bind 127.0.0.1 --open",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "build:pages": "slidev build example.md --base /slidev-addon-diagram-js/ --out dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:deps": "depcruise components plugins shared --config .dependency-cruiser.cjs --output-type err",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "author": "Marco Schäck (https://github.com/emaarco)",
  "license": "MIT",
  "dependencies": {
    "@bpmn-io/properties-panel": "3.55.0",
    "@emaarco/dmn-js-simulation": "0.3.1",
    "@miragon/event-storming-renderer": "0.2.2",
    "@miragon/team-topologies-renderer": "0.8.0",
    "@miragon/team-topologies-schema-model": "0.8.0",
    "@miragon/wardley-renderer": "0.6.2",
    "bpmn-js": "18.30.1",
    "bpmn-js-properties-panel": "5.65.1",
    "bpmn-js-token-simulation": "0.40.0",
    "camunda-bpmn-js-behaviors": "1.18.0",
    "camunda-bpmn-moddle": "8.0.1",
    "camunda-dmn-moddle": "1.3.1",
    "camunda-transaction-boundaries": "1.1.2",
    "diagram-js": "15.27.1",
    "dmn-js": "17.12.0",
    "dmn-js-properties-panel": "3.12.0",
    "zeebe-bpmn-moddle": "2.0.0"
  },
  "devDependencies": {
    "@miragon/slidev-toolkit": "1.18.0",
    "@slidev/cli": "53.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "dependency-cruiser": "18.4.0",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "playwright-chromium": "1.63.0",
    "portless": "0.15.6",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "keywords": [
    "slidev",
    "slidev-addon",
    "bpmn",
    "bpmn-js",
    "dmn",
    "dmn-js",
    "diagram-js",
    "bpmn.io",
    "diagram",
    "workflow",
    "process",
    "decision-table",
    "drd",
    "team-topologies",
    "wardley-maps",
    "event-storming"
  ],
  "files": [
    "components",
    "plugins",
    "shared",
    "vite.config.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@slidev/cli": ">=50",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@slidev/cli": {
      "optional": false
    },
    "vue": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaarco/slidev-addon-diagram-js.git"
  },
  "bugs": {
    "url": "https://github.com/emaarco/slidev-addon-diagram-js/issues"
  },
  "homepage": "https://github.com/emaarco/slidev-addon-diagram-js#readme"
}
